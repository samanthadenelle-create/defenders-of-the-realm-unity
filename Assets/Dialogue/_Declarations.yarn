title: _Declarations
tags: system
---
// =============================================================================
// Project-wide Yarn variable declarations.
//
// Yarn Spinner v3 requires EVERY variable used in interpolation ({$x}) or an
// expression to be DECLARED with a type. If even one is undeclared the WHOLE project
// fails to compile ("Can't determine the type of the expression $x") -> zero compiled
// nodes -> the runtime error "Cannot load node ...: No nodes have been loaded."
//
// Defaults live here so the project always compiles; the game (the dialogue bridge /
// GameState) sets the real live values at runtime. This node is never played or jumped
// to — it exists ONLY to declare types so the dialogue compiles and plays.
// =============================================================================

// — Strings: names / roles / phases (game overrides at runtime) —
<<declare $companionName = "Companion">>
<<declare $petName = "Pet">>
<<declare $petRole = "Defender">>
<<declare $petMode = "Defend">>
<<declare $tutorialPhase = "intro">>
<<declare $tutorialStep = "intro">>   // string steps: "place_first_tower", "first_combat", etc.

// — Numbers: counts / levels / resources —
<<declare $heroLevel = 1>>
<<declare $towersBuilt = 0>>
<<declare $soulsFreed = 0>>
<<declare $wood = 0>>
<<declare $stone = 0>>
<<declare $structureLevel = 0>>
<<declare $structureYield = 0>>

// — Structure interaction (the parameterized building hook; bridge sets these live) —
<<declare $structureId = "">>
<<declare $structureName = "Building">>
<<declare $upgradeCostText = "">>
<<declare $upgradeResult = "">>

// — Bools: progression + soul-freed flags —
<<declare $structureMaxed = false>>
<<declare $tutorialComplete = false>>
<<declare $postTutorialGuidanceGiven = false>>
<<declare $elderBlessingActive = false>>
<<declare $aldricFreed = false>>
<<declare $miraFreed = false>>
<<declare $elowenFreed = false>>
<<declare $sennaFreed = false>>
<<declare $varenFreed = false>>

// — WO-291 Vendor questline stage trackers (the "stemming" mechanic) —
// Each vendor's Talk node reads its $q_<vendor>_stage to show Stranger(0)→Hook(1)→
// InProgress(2..n)→Bonded(END=9). Persisted via Yarn VariableStorage; the REAL
// quest ledger (StartQuest/AdvanceQuest verbs → QuestService) is source of truth,
// these mirror it for cheap stage-aware branching. $villageLevel gates Stage-1 hooks.
<<declare $villageLevel = 1>>
<<declare $q_forge_stage = 0>>
<<declare $q_armorer_stage = 0>>
<<declare $q_lumber_stage = 0>>
<<declare $q_granary_stage = 0>>
<<declare $q_jeweler_stage = 0>>
<<declare $q_market_stage = 0>>
<<declare $q_inn_stage = 0>>
<<declare $q_stable_stage = 0>>
<<declare $q_steward_stage = 0>>
<<declare $sableChoiceReported = false>>

// — WO-238 Sylas (beat-1 companion) first-meeting / recruit flag —
// Mirrors the QuestService ledger flag (companion.sylas "met") for cheap re-entry
// branching in SylasFirstMeeting.yarn; the ledger is the source of truth.
<<declare $sylasMet = false>>

// =============================================================================
// — WO-294 Forgemasters' Saga (deep crafter questlines + reconciliation) —
// Yarn-side mirrors of the QuestService ledger (StartQuest/AdvanceQuest →
// forgemasters_act1..4). Source of truth = the ledger (IsQuestActive/IsQuestComplete);
// these locals drive cheap stage-aware branching inside each crafter's Saga node.
//
// $saga_act      : highest act the player has REACHED (0 = saga not begun, 4 = reforged).
// $saga_<x>_done : per-crafter / per-pairing beat flags within an act.
// The four vendor questlines (vendor.forge/armorer/lumbermill/granary) must each be
// at stage 9 (bonded) before the saga's Act I will open — that gathering of the four
// IS Act I's hidden premise (see DESIGN_FORGEMASTERS_SAGA_LEGENDARY.md §2).
// =============================================================================
<<declare $saga_act = 0>>

// Act I — "Honest Steel": each crafter privately mourns the broken Aegis (the seed).
<<declare $saga_borin_seeded = false>>
<<declare $saga_halvard_seeded = false>>
<<declare $saga_pell_seeded = false>>
<<declare $saga_wren_seeded = false>>

// Act II — "The Old Fire": the three reconciliations (brokered at Brom's hearth).
<<declare $saga_peace_borin_halvard = false>>   // the steel didn't fail — it was incomplete
<<declare $saga_peace_pell_forge = false>>      // the bough is for defending the Tree, not glory
<<declare $saga_peace_wren_hearth = false>>     // the shared meal — Wren says yes

// Act III — "What Was Lost": the four scattered techniques/components recovered.
<<declare $saga_comp_fold = false>>        // Threefold Fold — Stone Mountains (W)
<<declare $saga_comp_oathweld = false>>    // Oathweld breastplate restored — Frost Peaks (N)
<<declare $saga_comp_heartwood = false>>   // Heartwood Bough — Verdant Forest (E)
<<declare $saga_comp_pressing = false>>    // the Last Pressing — Ashen Wastes (S)

// Act IV — "The Reforging": the choice + the reforge.
// "heart" = draw from the Tree (immediate, somber); "regions" = gather from cleansed
// nodes (slower, the true ending). Persisted so the finale/NG+ can read it.
<<declare $saga_reforge_choice = "">>
<<declare $saga_reforged = false>>

// WO-296 — the two endings/finale beats keyed on the reforge choice. Set once the
// player has SEEN the path-specific ending (Heart = somber sacrifice; Regions = the
// "true"/whole ending). Read by the saga node so a re-entry replays the short coda,
// not the full finale; downstream finale/NG+ reads the path via $saga_reforge_choice
// (and the path-distinct keystone AegisReforgedHeart / AegisReforgedWhole).
<<declare $saga_ending_seen = false>>

// =============================================================================
// — WO-299 Wild Hearts: Fenn's pet-bond questlines (per-species bonds) —
// Yarn-side mirrors of the QuestService ledger (StartQuest/AdvanceQuest/SetQuestFlag
// → petbond.<species>). Source of truth = the ledger (IsQuestActive/IsQuestComplete
// + HasFlag); these locals drive cheap stage-aware branching inside the bond hub.
//
// $q_wildhearts_open : 1 once Fenn's umbrella "Wild Hearts" (vendor.stable) is bonded
//                      (keystone BondedBeast) and the per-species bond hub is unlocked.
// $petbond_<x>_stage : per-species bond progress (0 not begun → 9 bonded/companion).
// The PERK SEAM: reaching a species' bond tier fires
//   <<command: SetQuestFlag petbond.<species> perk_unlocked>>
// which the pet system reads via QuestService.HasFlag("petbond.<species>",
// "perk_unlocked") to enable that species' signature perk. We do NOT rewire Pet.cs
// here — this is a clean flag-based seam only.
// =============================================================================
<<declare $q_wildhearts_open = 0>>
<<declare $petbond_sproutling_stage = 0>>
<<declare $petbond_craghound_stage = 0>>
<<declare $petbond_frostkit_stage = 0>>
<<declare $petbond_emberpup_stage = 0>>
<<declare $petbond_mirewing_stage = 0>>
<<declare $petbond_glimmermoth_stage = 0>>
<<declare $petbond_stoneback_stage = 0>>
<<declare $petbond_aetherfox_stage = 0>>
===
