title: _Declarations
tags: system
---
// =============================================================================
// Project-wide Yarn variable declarations.
//
// Yarn Spinner v3 requires EVERY variable used in interpolation ({$x}) or an
// expression to be DECLARED with a type. If even one is undeclared the WHOLE project
// fails to compile ("Can't determine the type of the expression $x") -> zero compiled
// nodes -> the runtime error "Cannot load node ...: No nodes have been loaded."
//
// Defaults live here so the project always compiles; the game (the dialogue bridge /
// GameState) sets the real live values at runtime. This node is never played or jumped
// to — it exists ONLY to declare types so the dialogue compiles and plays.
// =============================================================================

// — Strings: names / roles / phases (game overrides at runtime) —
<<declare $companionName = "Companion">>
<<declare $petName = "Pet">>
<<declare $petRole = "Defender">>
<<declare $petMode = "Defend">>
<<declare $tutorialPhase = "intro">>
<<declare $tutorialStep = "intro">>   // string steps: "place_first_tower", "first_combat", etc.

// — Numbers: counts / levels / resources —
<<declare $heroLevel = 1>>
<<declare $towersBuilt = 0>>
<<declare $soulsFreed = 0>>
<<declare $wood = 0>>
<<declare $stone = 0>>
<<declare $structureLevel = 0>>
<<declare $structureYield = 0>>

// — Structure interaction (the parameterized building hook; bridge sets these live) —
<<declare $structureId = "">>
<<declare $structureName = "Building">>
<<declare $upgradeCostText = "">>
<<declare $upgradeResult = "">>

// — Bools: progression + soul-freed flags —
<<declare $structureMaxed = false>>
<<declare $tutorialComplete = false>>
<<declare $postTutorialGuidanceGiven = false>>
<<declare $elderBlessingActive = false>>
<<declare $aldricFreed = false>>
<<declare $miraFreed = false>>
<<declare $elowenFreed = false>>
<<declare $sennaFreed = false>>
<<declare $varenFreed = false>>

// — WO-291 Vendor questline stage trackers (the "stemming" mechanic) —
// Each vendor's Talk node reads its $q_<vendor>_stage to show Stranger(0)→Hook(1)→
// InProgress(2..n)→Bonded(END=9). Persisted via Yarn VariableStorage; the REAL
// quest ledger (StartQuest/AdvanceQuest verbs → QuestService) is source of truth,
// these mirror it for cheap stage-aware branching. $villageLevel gates Stage-1 hooks.
<<declare $villageLevel = 1>>
<<declare $q_forge_stage = 0>>
<<declare $q_armorer_stage = 0>>
<<declare $q_lumber_stage = 0>>
<<declare $q_granary_stage = 0>>
<<declare $q_jeweler_stage = 0>>
<<declare $q_market_stage = 0>>
<<declare $q_inn_stage = 0>>
<<declare $q_stable_stage = 0>>
<<declare $q_steward_stage = 0>>
<<declare $sableChoiceReported = false>>

// — WO-238 Sylas (beat-1 companion) first-meeting / recruit flag —
// Mirrors the QuestService ledger flag (companion.sylas "met") for cheap re-entry
// branching in SylasFirstMeeting.yarn; the ledger is the source of truth.
<<declare $sylasMet = false>>
