{
  "_note": "WO-595 KayKit modular dungeon kit. The single data source the composer reads. Owner thinks in data structures: change this JSON to change the kit, no code edit. Sockets N/S/E/W = open|closed; snapping mates open->open at cellSize with a yaw. parts[] positions are cell-anchor-relative (cell centre = 0,0,0). FBX under Assets/Models/KayKit/dungeon/fbx(unity)/. Grid measured, not assumed (4m cell / 4m walls).",
  "grid": {
    "cellSize": 4.0,
    "wallHeight": 4.0,
    "subGrid": 2.0,
    "doorWidth": 2.0,
    "doorHeight": 3.0,
    "wallOnEdgeCenterline": true,
    "levelStepY": 4.0
  },
  "themes": {
    "default": "dungeon_texture",
    "options": ["dungeon_texture", "alt_texture_1_Golden", "alt_texture_2_BlackAndWhite", "alt_texture_3_SepiaA", "alt_texture_4_SepiaB", "alt_texture_5_NightA", "alt_texture_6_NightB"],
    "materialDir": "Assets/Models/KayKit/dungeon/fbx(unity)/Materials/",
    "atlasDir": "Assets/Models/KayKit/KayKit Dungeon Remastered 1.1/Assets/textures/",
    "_note": "one shared UV atlas -> one material swap re-skins the whole kit"
  },
  "chunks": [
    { "id": "room_small",        "type": "room",          "cells": [1,1], "sockets": {"N":"closed","S":"closed","E":"closed","W":"closed"},
      "parts": [
        {"fbx":"floor_tile_large","pos":[0,0,0],"yaw":0},
        {"fbx":"wall","pos":[0,0,2],"yaw":0}, {"fbx":"wall","pos":[0,0,-2],"yaw":0},
        {"fbx":"wall","pos":[2,0,0],"yaw":90}, {"fbx":"wall","pos":[-2,0,0],"yaw":90},
        {"fbx":"wall_corner","pos":[2,0,2],"yaw":0}, {"fbx":"wall_corner","pos":[-2,0,2],"yaw":90},
        {"fbx":"wall_corner","pos":[2,0,-2],"yaw":270}, {"fbx":"wall_corner","pos":[-2,0,-2],"yaw":180},
        {"fbx":"ceiling_tile","pos":[0,4,0],"yaw":0}
      ] },
    { "id": "room_small_2door",  "type": "room",          "cells": [1,1], "sockets": {"N":"open","S":"open","E":"closed","W":"closed"},
      "parts": [
        {"fbx":"floor_tile_large","pos":[0,0,0],"yaw":0},
        {"fbx":"wall_doorway","pos":[0,0,2],"yaw":0}, {"fbx":"wall_doorway","pos":[0,0,-2],"yaw":0},
        {"fbx":"wall","pos":[2,0,0],"yaw":90}, {"fbx":"wall","pos":[-2,0,0],"yaw":90}
      ] },
    { "id": "room_medium",       "type": "room",          "cells": [2,2], "sockets": {"N":"open","S":"open","E":"open","W":"open"}, "parts": [] },
