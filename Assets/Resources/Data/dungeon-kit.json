    { "id": "dead_end",          "type": "dead_end",      "cells": [1,1], "sockets": {"N":"closed","S":"open","E":"closed","W":"closed"}, "parts": [] },
    { "id": "rubble_cap",        "type": "dead_end",      "cells": [1,1], "sockets": {"N":"closed","S":"open","E":"closed","W":"closed"}, "parts": [] },
    { "id": "door_gate",         "type": "access_point",  "cells": [1,1], "sockets": {"N":"open","S":"open","E":"closed","W":"closed"}, "parts": [] },
