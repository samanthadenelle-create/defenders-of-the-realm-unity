    { "id": "hall_straight",     "type": "hall_straight", "cells": [1,3], "sockets": {"N":"open","S":"open","E":"closed","W":"closed"}, "parts": [] },
    { "id": "hall_straight_short","type": "hall_straight","cells": [1,2], "sockets": {"N":"open","S":"open","E":"closed","W":"closed"}, "parts": [] },
