    { "id": "trap_spikes",       "type": "trap_room",     "cells": [1,1], "sockets": {"N":"open","S":"open","E":"closed","W":"closed"}, "parts": [] },
    { "id": "trap_pit",          "type": "trap_room",     "cells": [1,1], "sockets": {"N":"open","S":"open","E":"closed","W":"closed"}, "parts": [] },
    { "id": "trap_grate_hall",   "type": "trap_room",     "cells": [1,2], "sockets": {"N":"open","S":"open","E":"closed","W":"closed"}, "parts": [] },
    { "id": "pillar_hall",       "type": "hall_straight", "cells": [1,3], "sockets": {"N":"open","S":"open","E":"closed","W":"closed"}, "parts": [] }
