{
  "version": 1,
  "_note": "Scene-generation config — the data contract that determines WHAT scene the base-scene factory generates (WO-454; canon: docs/WORK_ORDER_454_faction_base_scene_generator.md). A base IS a scene: player stronghold, enemy outpost, garrison — all generated from one of these configs. ownership=Player => buildable/owned, no garrison; ownership=Enemy => faction garrison + boss. The generator (StructureFactory/CastleHubBuilder + GridWall + WaveManager-composition + EnemyFactory) consumes these; the config is the ONLY delta between scene types. Dual-copy (Resources copy wins at load via CanonicalJson; keep StreamingAssets in sync).",
  "_schema": {
    "id": "stable config id",
    "displayName": "player-facing name",
    "sceneName": "the additive scene this generates into / loads as (e.g. Garrison_troll_outpost)",
    "ownership": "Player | Enemy",
    "faction": "orc | hollow | troll | mixed | none",
    "wallTier": "Wood | Iron | ReinforcedSteel",
    "baseRadius": "perimeter radius (m)",
    "wallSegmentsPerSide": "tiled wall segments per side (force ODD so the gate centres)",
    "centralBuilding": "structures-catalog id placed at centre (command hut / mage base / heart)",
    "towers": "[{ type: structures-catalog id, count }]",
    "props": "{ set: [structures-catalog ids], count }",
    "garrison": "ENEMY only — { composition:[{enemyId,count}], baseEnemyLevel (absolute FLOOR), levelOffset (relative to PLAYER level), difficultyMultiplier, boss }. Generator computes enemyLevel = max(baseEnemyLevel, playerLevel + levelOffset) so outposts scale with the player but never below the floor (always a meaningful fight).",
    "themeColor": "faction banner/accent hex",
    "recommendedClearTime": "seconds — 3-star clear threshold (fast = mastery)",
    "twoStarTime": "seconds — 2-star threshold (~1.3x the 3-star). Above this but a clear = 1 star",
    "oneStarTime": "any clear earns at least 1 star (no upper bound)",
    "rewardMultiplier": "loot/reward scalar for this raid tier",
    "entranceCount": "perimeter gates: 2 = main + side breach (Regular), 1 = single gate (Hard/Extreme)",
    "interiorWallLayers": "concentric inner keep rings beyond the outer perimeter (0 = single ring, 1 = inner kill-zone keep)",
    "towerPlacementStyle": "Cardinal (mid-side, 4) | OverlappingFire (corners + mid-side crossfire)",
    "archerTowerCount": "Watchtower_Archer_* props placed (runtime-armed turrets)",
    "mageTowerCount": "Watchtower_Mage_* props placed (runtime-armed turrets)",
    "eliteCount": "elite garrison units (spawner/scoring data — not geometry)",
    "shardDropChance": "0..1 chance of a shard drop (3-star-only gating applied later by scoring — not geometry)"
  },
