<?xml version="1.0" encoding="utf-8"?>
<!--
  SettingsScreen.uxml — UI Toolkit options menu (audit P0-8 §2.1).
  ========================================================================
  The missing-components audit calls out "no settings menu anywhere". This
  is that screen: audio volume sliders, a graphics quality-tier selector
  and a screen-shake comfort toggle.

  Reached two ways:
    * the pause overlay's "Settings" button (PauseController), and
    * potentially a future title-screen "Options" entry.
  SettingsController shows / hides it; it does not own a scene of its own.

  SettingsController queries these elements by name (the "name" attribute
  is the binding contract — do not rename without updating the controller):
    settings-root        (VisualElement — the full-screen scrim + panel)
    settings-master-slider / settings-master-value
    settings-music-slider  / settings-music-value
    settings-sfx-slider    / settings-sfx-value
    settings-mute-toggle
    settings-quality-row   (VisualElement — tier buttons built at runtime)
    settings-difficulty-row   (VisualElement — Easy/Normal/Hard buttons at runtime)
    settings-difficulty-blurb (Label — what the chosen difficulty changes)
    settings-shake-toggle
    settings-audio-seam    (Label — shown when the AudioMixer is absent)
    settings-reset-button
    settings-back-button

  The quality-tier buttons are built ONCE at runtime by the controller into
  "settings-quality-row" — this UXML supplies only the row shell.
-->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="SettingsScreen.uss" />

    <!-- Full-screen dimming scrim — blocks input to whatever is behind. -->
    <ui:VisualElement name="settings-root" class="settings-root">

        <!-- ── The options panel ──────────────────────────────────────── -->
        <ui:VisualElement name="settings-panel" class="settings-panel">

            <!-- Header -->
            <ui:Label name="settings-title" text="Settings" class="settings-title" />

            <ui:ScrollView name="settings-scroll" class="settings-scroll"
                           mode="Vertical" vertical-scroller-visibility="Auto">

                <!-- ── Audio section ──────────────────────────────────── -->
                <ui:Label text="Audio" class="settings-section-caption" />

                <ui:VisualElement class="settings-row">
                    <ui:Label text="Master" class="settings-row__label" />
                    <ui:Slider name="settings-master-slider" class="settings-row__slider"
                               low-value="0" high-value="1.5" value="1" />
                    <ui:Label name="settings-master-value" text="100%" class="settings-row__value" />
                </ui:VisualElement>

                <ui:VisualElement class="settings-row">
                    <ui:Label text="Music" class="settings-row__label" />
                    <ui:Slider name="settings-music-slider" class="settings-row__slider"
                               low-value="0" high-value="1.5" value="0.7" />
                    <ui:Label name="settings-music-value" text="70%" class="settings-row__value" />
                </ui:VisualElement>

                <ui:VisualElement class="settings-row">
                    <ui:Label text="Sound FX" class="settings-row__label" />
                    <ui:Slider name="settings-sfx-slider" class="settings-row__slider"
                               low-value="0" high-value="1.5" value="0.8" />
                    <ui:Label name="settings-sfx-value" text="80%" class="settings-row__value" />
                </ui:VisualElement>

                <ui:VisualElement class="settings-row">
                    <ui:Label text="Mute all audio" class="settings-row__label" />
                    <ui:Toggle name="settings-mute-toggle" class="settings-row__toggle" />
                </ui:VisualElement>

                <!-- Audio-mixer seam notice — shown only when the mixer asset
                     is not yet present (the parallel Audio-system work). -->
                <ui:Label name="settings-audio-seam"
                          text="Audio mixer not yet wired — sliders are saved and will take effect once audio is integrated."
                          class="settings-seam-note" />

                <!-- ── Gameplay section ───────────────────────────────── -->
                <ui:Label text="Gameplay" class="settings-section-caption" />

                <ui:VisualElement class="settings-row settings-row--column">
                    <ui:Label text="Difficulty" class="settings-row__label" />
                    <!-- Easy / Normal / Hard buttons built at runtime by
                         SettingsController. Difficulty scales the between-wave
                         build window — Easy ~10 min, Normal ~5 min, Hard ~3 min. -->
                    <ui:VisualElement name="settings-difficulty-row" class="settings-difficulty-row" />
                    <ui:Label name="settings-difficulty-blurb"
                              text="The standard build window — about 5 minutes between waves."
                              class="settings-difficulty-blurb" />
                </ui:VisualElement>

                <!-- ── Graphics section ───────────────────────────────── -->
                <ui:Label text="Graphics" class="settings-section-caption" />

                <ui:VisualElement class="settings-row settings-row--column">
                    <ui:Label text="Quality" class="settings-row__label" />
                    <!-- Tier buttons built at runtime by SettingsController. -->
                    <ui:VisualElement name="settings-quality-row" class="settings-quality-row" />
                </ui:VisualElement>

                <!-- ── Accessibility section ──────────────────────────── -->
                <ui:Label text="Accessibility" class="settings-section-caption" />

                <ui:VisualElement class="settings-row">
                    <ui:Label text="Screen shake" class="settings-row__label" />
                    <ui:Toggle name="settings-shake-toggle" class="settings-row__toggle" />
                </ui:VisualElement>

            </ui:ScrollView>

            <!-- ── Footer buttons ─────────────────────────────────────── -->
            <ui:VisualElement name="settings-footer" class="settings-footer">
                <ui:Button name="settings-reset-button" text="Reset to defaults"
                           class="settings-button settings-button--ghost" />
                <ui:Button name="settings-back-button" text="Back"
                           class="settings-button settings-button--primary" />
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
