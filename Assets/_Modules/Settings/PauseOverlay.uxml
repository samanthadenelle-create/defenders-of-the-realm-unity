<?xml version="1.0" encoding="utf-8"?>
<!--
  PauseOverlay.uxml — UI Toolkit pause menu (audit P0-10 §2.3).
  ------------------------------------------------------------------------
  The missing-components audit calls out "no pause menu, no Time.timeScale
  handling, no pause input action". This is the pause overlay: a modal
  panel shown when the game is paused (PauseController sets
  Time.timeScale = 0 while it is up).

  Buttons:
    Resume    — un-pause, restore Time.timeScale, hide the overlay.
    Settings  — open the settings screen (SettingsController) over the top.
    Quit      — quit to the Title scene.

  PauseController queries these elements by name (the "name" attribute is
  the binding contract — do not rename without updating the controller):
    pause-root          (VisualElement — the full-screen scrim + panel)
    pause-resume-button
    pause-settings-button
    pause-quit-button
-->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="PauseOverlay.uss" />

    <!-- Full-screen dimming scrim — captures input while paused. -->
    <ui:VisualElement name="pause-root" class="pause-root">

        <!-- ── The pause panel ────────────────────────────────────────── -->
        <ui:VisualElement name="pause-panel" class="pause-panel">

            <ui:Label name="pause-title" text="Paused" class="pause-title" />
            <ui:Label name="pause-subtitle" text="The Heart holds. Take your moment."
                      class="pause-subtitle" />

            <ui:VisualElement name="pause-buttons" class="pause-buttons">
                <ui:Button name="pause-resume-button" text="Resume"
                           class="pause-button pause-button--primary" />
                <ui:Button name="pause-settings-button" text="Settings"
                           class="pause-button pause-button--ghost" />
                <ui:Button name="pause-quit-button" text="Quit to Title"
                           class="pause-button pause-button--danger" />
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
