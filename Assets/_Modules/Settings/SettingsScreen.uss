/*
 * SettingsScreen.uss — styling for the options menu (audit P0-8 §2.1).
 * ----------------------------------------------------------------------
 * Matches the project's UI Toolkit visual language (VillageHud.uss /
 * BuildMenu.uss / BattleHUD.uss): a dark Heart-Forest palette, violet
 * (#7C3AED-ish) for the Heart accent, amber for the primary call-to-action,
 * mint-green for "on" toggles, muted greys for body copy. Values are inline
 * — the project Theme is C#-driven, not USS variables — kept in sync by
 * hand, the established BattleHUD / BuildMenu convention.
 *
 * The root paints a full-screen dimming scrim; the panel is centred and
 * modal — unlike the HUD this surface deliberately captures all input.
 *
 * USS class names SettingsController toggles / builds with:
 *   quality-tier-button / quality-tier-button--active
 */

/* ── Root — full-screen modal scrim ─────────────────────────────────── */
.settings-root {
    flex-grow: 1;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(8, 6, 14, 0.82);
    align-items: center;
    justify-content: center;
}

/* ── The options panel ──────────────────────────────────────────────── */
.settings-panel {
    width: 460px;
    max-height: 86%;
    flex-direction: column;
    padding: 20px;
    border-radius: 16px;
    background-color: rgba(15, 12, 24, 0.98);
    border-width: 1px;
    border-color: rgba(124, 58, 237, 0.5);
}

.settings-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(237, 233, 250);
    margin-bottom: 12px;
    -unity-text-align: middle-center;
}

.settings-scroll {
    flex-grow: 1;
}

/* ── Section captions ───────────────────────────────────────────────── */
.settings-section-caption {
    margin-top: 12px;
    margin-bottom: 4px;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(150, 142, 170);
}

/* ── A settings row ─────────────────────────────────────────────────── */
.settings-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
    margin-bottom: 6px;
    padding: 8px 10px;
    border-radius: 10px;
    background-color: rgba(28, 24, 42, 0.85);
}

.settings-row--column {
    flex-direction: column;
    align-items: stretch;
}

.settings-row__label {
    width: 120px;
    font-size: 14px;
    color: rgb(206, 200, 222);
}

.settings-row__slider {
    flex-grow: 1;
    margin-left: 4px;
    margin-right: 8px;
}

.settings-row__value {
    width: 52px;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(125, 211, 252);
    -unity-text-align: middle-right;
}

.settings-row__toggle {
    flex-grow: 1;
    -unity-text-align: middle-right;
}

/* ── Graphics quality tier selector ─────────────────────────────────── */
.settings-quality-row {
    flex-direction: row;
    margin-top: 8px;
    justify-content: space-between;
}

/* One tier button — built at runtime by SettingsController. */
.quality-tier-button {
    flex-grow: 1;
    height: 44px;
    margin-left: 4px;
    margin-right: 4px;
    font-size: 12px;
    -unity-font-style: bold;
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(124, 58, 237, 0.4);
    color: rgb(196, 181, 253);
    background-color: rgba(28, 24, 42, 0.92);
    white-space: normal;
}

.quality-tier-button:hover {
    border-color: rgba(196, 181, 253, 0.7);
}

.quality-tier-button--active {
    color: rgb(28, 22, 10);
    background-color: rgb(245, 196, 90);
    border-color: rgb(252, 224, 156);
}

/* ── Audio-mixer seam note ──────────────────────────────────────────── */
.settings-seam-note {
    margin-top: 4px;
    padding: 6px 10px;
    font-size: 11px;
    -unity-font-style: italic;
    color: rgb(245, 196, 90);
    white-space: normal;
}

/* ── Footer ─────────────────────────────────────────────────────────── */
.settings-footer {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 14px;
}

.settings-button {
    min-width: 130px;
    height: 48px;
    margin-left: 10px;
    font-size: 15px;
    -unity-font-style: bold;
    border-radius: 12px;
    border-width: 0;
}

.settings-button--primary {
    color: rgb(28, 22, 10);
    background-color: rgb(245, 196, 90);
}

.settings-button--primary:hover {
    background-color: rgb(255, 212, 120);
}

.settings-button--ghost {
    color: rgb(206, 200, 222);
    background-color: rgba(255, 255, 255, 0.07);
}

.settings-button--ghost:hover {
    background-color: rgba(255, 255, 255, 0.14);
}
