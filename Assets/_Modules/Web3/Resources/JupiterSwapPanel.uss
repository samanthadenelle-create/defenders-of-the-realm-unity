/*
 * JupiterSwapPanel.uss — swap bottom-sheet overlay.  WO-43.
 * -----------------------------------------------------------
 * Colours: deep indigo base, amber accents — matches the SelectScreen
 * palette so the panel feels at home on the hero-select / village screens.
 */

/* Full-screen dimmer */
.swap-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.65);
    flex-direction: column;
    justify-content: flex-end;
    align-items: stretch;
}

/* Bottom sheet */
.swap-sheet {
    background-color: rgba(18, 12, 30, 0.98);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-top-width: 2px;
    border-left-color: rgb(245, 166, 35);
    border-right-color: rgb(245, 166, 35);
    border-top-color: rgb(245, 166, 35);
    border-bottom-color: rgb(245, 166, 35);
    padding-top: 20px;
    padding-right: 24px;
    padding-bottom: 32px;
    padding-left: 24px;
    flex-direction: column;
    align-items: stretch;
}

/* Header */
.swap-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.swap-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(237, 233, 250);
}

.swap-close-btn {
    width: 32px;
    height: 32px;
    font-size: 22px;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgba(196, 181, 253, 0.3);
    border-right-color: rgba(196, 181, 253, 0.3);
    border-top-color: rgba(196, 181, 253, 0.3);
    border-bottom-color: rgba(196, 181, 253, 0.3);
    background-color: rgba(255, 255, 255, 0.05);
    color: rgba(196, 181, 253, 0.7);
    -unity-text-align: middle-center;
}

.swap-close-btn:hover {
    border-left-color: rgba(245, 166, 35, 0.55);
    border-right-color: rgba(245, 166, 35, 0.55);
    border-top-color: rgba(245, 166, 35, 0.55);
    border-bottom-color: rgba(245, 166, 35, 0.55);
    color: rgb(245, 166, 35);
}

/* Input row */
.swap-input-row {
    flex-direction: row;
    align-items: center;
    background-color: rgba(38, 26, 52, 0.9);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgba(124, 58, 237, 0.35);
    border-right-color: rgba(124, 58, 237, 0.35);
    border-top-color: rgba(124, 58, 237, 0.35);
    border-bottom-color: rgba(124, 58, 237, 0.35);
    padding-left: 16px;
    padding-right: 16px;
    height: 56px;
    margin-bottom: 14px;
}

.swap-input-amount {
    flex-grow: 1;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(237, 233, 250);
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-left;
}

.swap-input-token {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgba(196, 181, 253, 0.8);
    margin-left: 8px;
}

/* Output row */
.swap-output-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
}

.swap-output-label {
    font-size: 13px;
    color: rgba(196, 181, 253, 0.65);
}

.swap-skr-out {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(245, 166, 35);
}

/* Fee breakdown */
.swap-fee-block {
    background-color: rgba(38, 26, 52, 0.6);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    padding-top: 12px;
    padding-right: 14px;
    padding-bottom: 12px;
    padding-left: 14px;
    margin-bottom: 14px;
}

.swap-fee-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.swap-fee-key {
    font-size: 12px;
    color: rgba(196, 181, 253, 0.6);
}

.swap-fee-val {
    font-size: 12px;
    color: rgba(237, 233, 250, 0.85);
}

/* Status line */
.swap-status {
    font-size: 12px;
    -unity-font-style: italic;
    color: rgba(245, 166, 35, 0.8);
    -unity-text-align: middle-center;
    min-height: 18px;
    margin-bottom: 10px;
}

.swap-status--error {
    color: rgba(255, 90, 90, 0.9);
}

/* Confirm button */
.swap-confirm-btn {
    height: 52px;
    font-size: 16px;
    -unity-font-style: bold;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-color: rgb(245, 166, 35);
    color: rgb(22, 14, 6);
    margin-bottom: 12px;
}

.swap-confirm-btn:hover {
    background-color: rgb(255, 186, 70);
}

.swap-confirm-btn--disabled {
    background-color: rgba(255, 255, 255, 0.08);
    color: rgba(237, 233, 250, 0.3);
}

/* Powered-by */
.swap-powered-by {
    font-size: 11px;
    color: rgba(196, 181, 253, 0.35);
    -unity-text-align: middle-center;
}
