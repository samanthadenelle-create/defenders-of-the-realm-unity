/*
 * BuildMenu.uss — styling for the village build menu (Week 4).
 * ----------------------------------------------------------------------
 * RE-SKINNED to the shared ElarionUi town-HUD canon (DeNelle.Core.UI.
 * ElarionUi): warm stone panels + runic-gold rim + parchment-cream text,
 * affordable green / danger red for state. USS cannot reference the C#
 * palette fields, so the canon colours are mirrored here BY HAND (the
 * established HUD convention) — keep in sync with ElarionUi.* :
 *   PanelStone     #2c2115  -> rgba(44, 33, 21, .94)
 *   PanelStoneDark #1c160f  -> rgba(28, 22, 15, .97)
 *   Gold           #d4af37  -> rgb(212, 175, 55)
 *   Gilt           #eec848  -> rgb(238, 200, 72)
 *   Parchment      #f3eada  -> rgb(243, 234, 211)
 *   ParchmentDim   #c7bda8  -> rgb(199, 189, 168)
 *   Ink            #23190e  -> rgb(35, 25, 14)
 *   StoneTrim      #8b5e3c  -> rgb(139, 94, 60)
 *   Affordable     #75bd6b  -> rgb(117, 189, 107)
 *   Danger         #db5752  -> rgb(219, 87, 82)
 *
 * USS class names are the styling contract BuildMenu.cs builds cards with:
 *   build-card / build-card--selected / build-card--unaffordable
 *   build-card__name / build-card__desc / build-card__footer
 *   build-card__cost / build-card__cost--unaffordable / build-card__hp
 */

/* ── Root — full-screen, transparent, pass-through ──────────────────── */
.build-menu-root {
    flex-grow: 1;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

/* ── Floating panel — dark stone glass + runic-gold rim ─────────────── */
.build-menu-panel {
    position: absolute;
    width: 264px;
    flex-direction: column;
    padding: 12px;
    border-radius: 14px;
    background-color: rgba(28, 22, 15, 0.97);
    border-width: 1px;
    border-color: rgba(212, 175, 55, 0.55);
}

/* ── Header ─────────────────────────────────────────────────────────── */
.build-menu-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.build-menu-title {
    flex-grow: 1;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(238, 200, 72);
}

.build-menu-balance {
    margin-right: 8px;
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(238, 200, 72);
}

.build-menu-close {
    width: 22px;
    height: 22px;
    padding: 0;
    border-radius: 11px;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(243, 234, 211);
    background-color: rgba(0, 0, 0, 0.25);
    border-width: 0;
}

.build-menu-close:hover {
    background-color: rgba(219, 87, 82, 0.55);
    color: rgb(243, 234, 211);
}

/* ── Building list ──────────────────────────────────────────────────── */
.build-menu-scroll {
    max-height: 280px;
}

.build-menu-list {
    flex-direction: column;
    align-items: stretch;
}

/* ── Building card — dark stone cell + thin gold rim ────────────────── */
.build-card {
    flex-direction: column;
    margin-bottom: 8px;
    padding: 10px;
    border-radius: 10px;
    background-color: rgba(44, 33, 21, 0.94);
    border-width: 1px;
    border-color: rgba(212, 175, 55, 0.30);
}

.build-card:hover {
    border-color: rgba(238, 200, 72, 0.7);
}

.build-card--selected {
    border-color: rgb(238, 200, 72);
    background-color: rgba(60, 46, 28, 0.96);
}

.build-card--unaffordable {
    opacity: 0.55;
}

.build-card__name {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(243, 234, 211);
}

.build-card__desc {
    margin-top: 2px;
    font-size: 11px;
    -unity-font-style: italic;
    color: rgb(199, 189, 168);
    white-space: normal;
}

.build-card__footer {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.build-card__cost {
    flex-grow: 1;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(238, 200, 72);
}

.build-card__cost--unaffordable {
    color: rgb(219, 87, 82);
}

.build-card__hp {
    font-size: 11px;
    color: rgb(199, 189, 168);
}

/* ── Status / placement-hint banner ─────────────────────────────────── */
.build-menu-status {
    margin-top: 6px;
    min-height: 18px;
    font-size: 11px;
    -unity-font-style: italic;
    color: rgb(199, 189, 168);
    white-space: normal;
    -unity-text-align: middle-center;
}

.build-menu-status--error {
    color: rgb(219, 87, 82);
}

/* ── WO-31: Root chooser tiles ──────────────────────────────────────── */
.build-option-tile {
    flex-direction: column;
    align-items: flex-start;
    margin-bottom: 8px;
    padding: 12px;
    border-radius: 10px;
    background-color: rgba(44, 33, 21, 0.94);
    border-width: 1px;
    border-color: rgba(212, 175, 55, 0.30);
    -unity-text-align: upper-left;
    white-space: normal;
}

.build-option-tile:hover {
    border-color: rgba(238, 200, 72, 0.7);
    background-color: rgba(60, 46, 28, 0.96);
}

/* ── WO-31: Back nav ────────────────────────────────────────────────── */
.build-menu-back-btn {
    align-self: flex-start;
    margin-bottom: 6px;
    padding: 2px 8px;
    font-size: 12px;
    color: rgb(199, 189, 168);
    background-color: rgba(0, 0, 0, 0.22);
    border-width: 0;
    border-radius: 8px;
}

.build-menu-back-btn:hover {
    color: rgb(243, 234, 211);
    background-color: rgba(0, 0, 0, 0.35);
}

/* ── WO-31: Element radio group ─────────────────────────────────────── */
.element-radio-group {
    flex-direction: column;
    margin-top: 4px;
    margin-bottom: 8px;
}

.element-radio-row {
    margin-bottom: 4px;
    padding: 6px 10px;
    font-size: 13px;
    -unity-text-align: middle-left;
    color: rgb(243, 234, 211);
    background-color: rgba(44, 33, 21, 0.85);
    border-width: 1px;
    border-color: rgba(212, 175, 55, 0.30);
    border-radius: 14px;
}

.element-radio-row:hover {
    border-color: rgba(238, 200, 72, 0.7);
}

.element-radio-row--selected {
    color: rgb(35, 25, 14);
    background-color: rgb(238, 200, 72);
    border-color: rgb(238, 200, 72);
    -unity-font-style: bold;
}

/* ── WO-31: Cost rows ───────────────────────────────────────────────── */
.cost-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 2px;
}

.cost-check {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(117, 189, 107);
}

.cost-fail {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(219, 87, 82);
}

/* ── WO-31: Confirm (Build / Upgrade) button — gold CTA, ink text ───── */
.build-confirm-btn {
    margin-top: 10px;
    padding: 8px;
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(35, 25, 14);
    background-color: rgb(212, 175, 55);
    border-width: 1px;
    border-color: rgba(238, 200, 72, 0.9);
    border-radius: 10px;
}

.build-confirm-btn:hover {
    background-color: rgb(238, 200, 72);
}

.build-confirm-btn:disabled {
    opacity: 0.4;
}

/* ── WO-31: Upgrade tower-select rows ───────────────────────────────── */
.tower-row {
    margin-bottom: 4px;
    padding: 6px 10px;
    font-size: 13px;
    -unity-text-align: middle-left;
    color: rgb(243, 234, 211);
    background-color: rgba(44, 33, 21, 0.85);
    border-width: 1px;
    border-color: rgba(139, 94, 60, 0.50);
    border-radius: 10px;
}

.tower-row:hover {
    border-color: rgba(238, 200, 72, 0.7);
}

.tower-row--selected {
    color: rgb(35, 25, 14);
    background-color: rgb(238, 200, 72);
    border-color: rgb(238, 200, 72);
    -unity-font-style: bold;
}
