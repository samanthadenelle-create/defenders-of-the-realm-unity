# Unity .gitignore — based on github/gitignore Unity.gitignore template.
# Placed at the repo root before Unity first generates Library/ etc.

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
# F8 triage inbox (runtime artifacts; keep README)
!/logs/
!/logs/f8-inbox/
logs/f8-inbox/*
!logs/f8-inbox/README.md
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data.
/[Mm]emoryCaptures/

# Recordings can get excessive in size.
/[Rr]ecordings/

# Autogenerated Jetbrains Rider plugin.
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory.
.vs/

# Gradle cache directory.
.gradle/

# Autogenerated VS/MD/Consulo solution and project files.
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files.
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports.
sysinfo.txt

# Build artifacts (owner-test builds only — never committed).
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file.
crashlytics-build.properties

# Packed Addressables.
/[Aa]ssets/[Aa]ddressableAssetsData/*/*.bin*

# Temporary auto-generated Android Assets.
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# OS / editor noise.
.DS_Store
Thumbs.db

# Solana / wallet secrets — never commit keypairs or seed phrases (spec Part 10).
*.keypair.json
**/secrets/
*.seed

# Vercel deploy token for the dedicated build machine — machine-local secret, never commit.
.vercel-token
.vercel-token.*
.vercel/

# Claude Code — local permission grant is personal/machine-scoped, not committed.
.claude/settings.local.json

# Unity batchmode build/test artifacts (regenerated; never committed).
/unity-*.log
/*-test-results.xml

# Imported KayKit art packs (~1.5 GB). Owner copies these in locally; they are
# not redistributable and far too bulky for the repo. The scene BUILDERS under
# Assets/Editor/ are the source of truth — they reconstruct the scenes from
# whatever KayKit models are present. (Owner instruction 2026-05-18:
# "exclude not needed files from the assets during check in".)
# EXCEPTION: the optimized People NPC pack (DEF-91) IS committed via LFS after a
# source-shrink pass (~90 MB) - see NpcPackSourceCompressor / NpcPackTrimmer.
/Assets/Models/*
!/Assets/Models/People/
# ...but not the redundant CGTrader mesh exports (Unity imports only the .fbx).
/Assets/Models/People/**/*.obj
/Assets/Models/People/**/*.obj.meta
/Assets/Models/People/**/*.ma
/Assets/Models/People/**/*.ma.meta
/Assets/Models/People/**/*.mtl
/Assets/Models/People/**/*.mtl.meta

# Owner Tripo art — large FBX kept local (same policy as Models/). The builder
# bakes them by path; on a fresh clone re-copy from the owner's source folder
# (the Portal falls back to a box doorway, buildings would need the re-copy).
/Assets/Art/TripoStructures/
/Assets/Art/TripoStructures.meta
/Assets/Resources/Structures/
/Assets/Resources/Structures.meta

# Low Poly Ultimate Pack (polyperfect) — 246MB asset pack kept LOCAL (owner
# instruction 2026-05-29: "use what you like and we can not git the others").
# Only the SPECIFIC prefabs/meshes we use are committed, copied into a tracked
# Resources/ path; on a fresh clone re-import the pack from the Asset Store.
/Assets/polyperfect/
/Assets/polyperfect.meta

# Supercyan "Character Pack: Fantasy" — Asset-Store char/anim pack kept LOCAL
# (same policy as polyperfect, 2026-06-14). Provides troop/hero test bodies +
# ~310 Humanoid anims. Only the SC_Footman/SC_Archer variants we use live in a
# tracked Resources/ path. On a fresh clone: re-import the pack from the Asset
# Store, then run Defenders/Art/Fix Supercyan URP Materials (converts Built-in
# shaders -> URP so it isn't magenta). See docs/SUPERCYAN_REIMPORT.md.
/Assets/Supercyan/
/Assets/Supercyan.meta

# === Session-noise / dev workflow (added 2026-05-20) ===
# Stale build logs left behind by batch Unity invocations.
build-*.log
*.log
arrival-diag.log
verify*.log
fix-mats.log
knight-setup*.log
ranger-*.log
wizard-*.log
real-diag.log
portraits*.log

# Local-only safety backups (Tripo originals etc.).
/Backups/

# Sub-agent transcript scratch.
/.utmp/

# Session log files written to repo root.
/SESSION-*.md

# Pre-push backup of .git — kept until first successful push, then deleted.
/.git-pre-push-backup/

# Recovery backups created by the 2026-05-24 GUID-remap pass. Safe to delete
# once Unity has imported the corrected .meta files and you've verified.
*.meta.bak
*.meta.bak.meta

# ── Secrets (v2-unity-port-backend-spec Part 5.2) — added 2026-05-27 ──
.env
.env.local
.env.*.local
*.jks
*.keystore
*.p12
keystore.properties

# Generated config
Assets/Generated/

# Test wallets (devnet only, but still treat as secrets)
Assets/Tests/Fixtures/DevnetTestWallet.*

# Vercel CLI leftovers (Unity is not a Vercel project; these are stray)
.vercel/
.vercelignore

# ── Vendor VFX packs (gate-stabilize 2026-05-31) ──
# Bulky Asset-Store VFX packs kept LOCAL — same policy as KayKit/Tripo/polyperfect.
# Only the specific effects we use are referenced by path; re-import on fresh clone.
# (Mirza Beig = 3,426 files, Spells Pack = 2,037 — kept the tree out of git-add-all danger.)
/Assets/Mirza Beig/
/Assets/Mirza Beig.meta
/Assets/Spells Pack/
/Assets/Spells Pack.meta
# Hovl Studio VFX pack (236MB, 2026-07-10) — same policy: only the keys we map
# in HovlVfxCatalog are referenced by path; re-import on fresh clone.
/Assets/Hovl Studio/
/Assets/Hovl Studio.meta

# TextMesh Pro package EXAMPLES — re-imported by the TMP package, not our code
# (34 example scripts that kept churning the working tree). Keep off git.
/Assets/TextMesh Pro/Examples & Extras/

# Cross-repo implementation staging (defenders-unity-review deltas, *_delta.cs) —
# NOT part of feat/tower-core-loop; kept local for reference only, never committed here.
/CC_implementations/

# UI-bounced files (compile-failed drafts returned for rework) — scratch, not tracked.
/_ui_bounced/

# Stray root-level scripts (must live under Assets/ to compile; kept out of git).
/ColliderVisualizer.cs

# ── Additional Unity 6 / Mobile / Solana (extended for this project) ──
# Unity 6 Library sub-artifacts and newer caches (broad match already covers most).
/[Ll]ibrary/Artifacts/
/[Ll]ibrary/ArtifactDB-*
/[Ll]ibrary/SourceAssetDB-*

# Mobile platform build extras (iOS/Android).
*.ipa
*.dSYM.zip
GoogleService-Info.plist
google-services.json
**/Il2CppOutputProject/
**/gradleBuild/
**/build/
**/app/build/

# Solana CLI + local validator + common dev key artifacts (beyond *.keypair.json).
**/id.json
**/test-ledger/
**/.solana/
**/*-keypair.json
**/.config/solana/
phantom-*.log
seeker-*.log

# Editor / IDE extras (Rider, VS Code, JetBrains).
.idea/
*.iml
.vscode/
*.code-workspace

# Unity Addressables / Player build temp that can leak.
**/PlayerBuildAnalyticsEvents.json
**/buildlog.txt

# Potential native Solana/JS bridge or temp wallet adapter outputs in Plugins or root (defensive).
**/node_modules/
package-lock.json
yarn.lock
*.js.map


# Local recovery backups & session config (cleanup 2026-06-09)
/Assets/_Recovery/
/Assets/_Recovery.meta
# Ignore local .claude state (settings, scheduled-task locks) but SHARE skills.
# Note: must ignore CONTENTS (/.claude/*) not the dir, so the re-include works —
# git can't un-ignore a path whose parent dir is fully ignored.
/.claude/*
!/.claude/skills/

# Large third-party / re-importable asset packs — re-import on fresh clone
# (same policy as polyperfect; keeps the repo lean). Cleanup 2026-06-09.
/Assets/Quaternius/
/Assets/Quaternius.meta
# Blink RPG Art ULTIMATE Bundle (Spark Framework) — big pack, restored to disk 2026-06-16;
# kept gitignored (owner policy: packs stay out of git until an explicit used-closure commit).
/Assets/Blink/
/Assets/Blink.meta
# Black Dragon boss pack — orphaned per usage audit (live boss uses the Tripo Dragon.fbx; dragon
# rebrand-cut). Un-tracked 2026-06-16; kept on disk, out of git.
/Assets/Black Dragon/
/Assets/Black Dragon.meta
/Assets/Medieval Village/
/Assets/Medieval Village.meta
/Assets/TextMesh Pro/
/Assets/TextMesh Pro.meta
/Assets/Action/textures/
/Assets/Action/textures.meta
/Assets/Models/People/Human/
/Assets/Models/People/Human.meta
/Assets/Models/People/Orc/
/Assets/Models/People/Orc.meta
/Assets/Models/People/Troll/
/Assets/Models/People/Troll.meta
/Assets/Models/People/textures/
/Assets/Models/People/textures.meta
/Assets/Lana Studio/Casual RPG VFX/Upgrade for URP/
/Assets/Lana Studio/Casual RPG VFX/Upgrade for URP.meta

# Tech hud elements RPG UI pack (~169MB incl. a ~100MB Psd/) — local import, same
# policy: gitignored, only the SPECIFIC sprites we use are copied into a tracked
# Resources path (RpgUiImporter -> Resources/RpgUi). Owner+CLI decision 2026-06-13.
/Assets/Tech hud elements/
/Assets/Tech hud elements.meta
.vercel

# Local API keys (never commit)
.secrets/

# Raw audio drop (rip source files, not committed)
Tools/AudioGen/drop/

# F8 felt-test capture archives — large PNG/break-log dumps, preservation-only, never in git
QA_F8_ARCHIVE/

# Temp CLI terminal output dumps (disposable scratch)
terminals/

# Generated Addressables link.xml (build artifact, not source)
/Assets/AddressableAssetsData/link.xml
/Assets/AddressableAssetsData/link.xml.meta

tools/docs/__pycache__/
.env*
